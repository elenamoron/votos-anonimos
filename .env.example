# Contraseña del panel de administración
ADMIN_PASSWORD=cambia-esta-contraseña

# Secreto para firmar la cookie de sesión (usa una cadena larga y aleatoria)
SESSION_SECRET=cambia-este-secreto-largo-y-aleatorio

# Localmente se usa SQLite en data/votos.db (sin configurar nada).
# Turso (opcional, plan gratuito) — https://turso.tech
# TURSO_DATABASE_URL=libsql://tu-db.turso.io
# TURSO_AUTH_TOKEN=tu-token
